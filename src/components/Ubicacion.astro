---
// src/components/Ubicacion.astro
interface Props {
  fechaTexto?: string;
  lugar?: string;
  direccion?: string;
}

const {
  fechaTexto = "Sábado 31 de octubre a las 21.00",
  lugar = "Club Villa Mengelle",
  direccion = "Club Villa Mengelle, Boulevard San Martín y Ceballos, Jacinto Aráuz, La Pampa",
} = Astro.props;

const mapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(direccion)}`;
---

<section class="ubicacion">
  <div class="bloque">
    <p class="pregunta">¿Cuándo es?</p>
    <p class="respuesta">{fechaTexto}</p>
  </div>

  <div class="divisor-orn" aria-hidden="true">
    <span class="linea"></span>
    <span class="rombo"></span>
    <span class="linea"></span>
  </div>

  <div class="bloque">
    <p class="pregunta">¿Dónde?</p>
    <p class="respuesta">{lugar}</p>
  </div>

  <a class="boton-mapa" href={mapsUrl} target="_blank" rel="noopener noreferrer">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M12 22s8-7.4 8-13a8 8 0 1 0-16 0c0 5.6 8 13 8 13Z"
        stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"
      />
      <circle cx="12" cy="9" r="2.6" stroke="currentColor" stroke-width="1.6" />
    </svg>
    Cómo llegar
  </a>
</section>

<style>
  .ubicacion {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 3.5rem 1.75rem;
    background: #fffdfb;
    text-align: center;
  }

  .bloque {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .pregunta {
    margin: 0;
    font-family: "Cormorant", serif;
    font-weight: 500;
    font-size: 0.9rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: #8a8681;
  }

  .respuesta {
    margin: 0;
    font-family: "Cormorant Garamond", serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.3rem, 6vw, 1.7rem);
    color: #231f20;
  }

  .divisor-orn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1.8rem 0;
  }

  .divisor-orn .linea {
    width: 42px;
    height: 1px;
    background: #c9c4be;
  }

  .divisor-orn .rombo {
    width: 6px;
    height: 6px;
    background: #d9584a;
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  .boton-mapa {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 2.2rem;
    padding: 0.85rem 1.9rem;
    border: 1px solid #d9584a;
    border-radius: 999px;
    font-family: "Cormorant", serif;
    font-weight: 500;
    font-size: 0.9rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #d9584a;
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .boton-mapa:active {
    background-color: #d9584a;
    color: #fffdfb;
  }

  @media (hover: hover) {
    .boton-mapa:hover {
      background-color: #d9584a;
      color: #fffdfb;
    }
  }
</style>