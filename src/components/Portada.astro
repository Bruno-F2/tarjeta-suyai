---
// src/components/Portada.astro
interface Props {
  nombre?: string;
}

const { nombre = "uyi" } = Astro.props;
---

<section class="portada" aria-label="Portada de la invitación de XV años">
  <!-- marco tipo tarjetería fina: doble filete con separación -->
  <div class="marco" aria-hidden="true"></div>

  <div class="contenido">
    <p class="etiqueta">Mis XV</p>

    <div class="monograma">
      <span class="inicial">S</span>
      <span class="resto">{nombre}</span>

      <!-- mariposa vectorial, ajustada exactamente a su dibujo, sin espacios extra -->
      <svg class="mariposa" viewBox="0 0 84 74" aria-hidden="true">
        <defs>
          <linearGradient id="alaGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#F2B4A3" />
            <stop offset="100%" stop-color="#D9584A" />
          </linearGradient>
        </defs>

        <g class="cuerpo-mariposa">
          <!-- ala superior derecha -->
          <g class="ala ala-der">
            <path d="M42,37 C52,18 68,9 78,15 C86,21 83,35 71,41 C61,46 49,43 42,37 Z"
                  fill="url(#alaGrad)" stroke="#231F20" stroke-width="0.6" opacity="0.94"/>
            <path d="M43,35 C52,26 62,19 72,21" fill="none" stroke="#231F20" stroke-width="0.35" opacity="0.5"/>
            <circle cx="64" cy="24" r="1.6" fill="#231F20" opacity="0.35"/>
          </g>

          <!-- ala inferior derecha -->
          <g class="ala ala-der-inf">
  <path
    d="M43,39
       C51,47 61,56 59,64
       C58,70 50,73 44,68
       C38,63 37,52 39,45
       C40,42 41,40 43,39 Z"
    fill="url(#alaGrad)"
    stroke="#231F20"
    stroke-width="0.6"
    opacity="0.86"
  />
</g>

          <!-- ala superior izquierda -->
          <g class="ala ala-izq">
            <path d="M42,37 C32,18 16,9 6,15 C-2,21 1,35 13,41 C23,46 35,43 42,37 Z"
                  fill="url(#alaGrad)" stroke="#231F20" stroke-width="0.6" opacity="0.94"/>
            <path d="M41,35 C32,26 22,19 12,21" fill="none" stroke="#231F20" stroke-width="0.35" opacity="0.5"/>
            <circle cx="20" cy="24" r="1.6" fill="#231F20" opacity="0.35"/>
          </g>

          <!-- ala inferior izquierda -->
          <g class="ala ala-izq-inf">
  <path
    d="M41,39
       C33,47 23,56 25,64
       C26,70 34,73 40,68
       C46,63 47,52 45,45
       C44,42 43,40 41,39 Z"
    fill="url(#alaGrad)"
    stroke="#231F20"
    stroke-width="0.6"
    opacity="0.86"
  />
</g>

          <!-- cuerpo -->
          <ellipse cx="42" cy="37" rx="1.6" ry="4" fill="#231F20"/>
          <ellipse cx="42" cy="43" rx="1.4" ry="4.5" fill="#231F20"/>

          <!-- antenas -->
          <path d="M41,34 C38,29 35,27 33,23" stroke="#231F20" stroke-width="0.5" fill="none" stroke-linecap="round"/>
          <path d="M43,34 C46,29 49,27 51,23" stroke="#231F20" stroke-width="0.5" fill="none" stroke-linecap="round"/>
        </g>
      </svg>
    </div>

    <div class="divisor-orn" aria-hidden="true">
      <span class="linea"></span>
      <span class="rombo"></span>
      <span class="linea"></span>
    </div>
  </div>

  <div class="scroll-cue" aria-hidden="true">
    <span>Desliza para descubrir más</span>
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
      <path
        d="M2 5L8 11L14 5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>

  <style>
    @import url("https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;1,400&family=Cormorant+Garamond:ital@1&display=swap");

    .portada {
      position: relative;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.6rem;
      background: #fffdfb;
      color: #231f20;
      text-align: center;
      overflow: hidden;
    }

    /* --- marco tipo tarjetería: doble filete con aire entre líneas --- */
    .marco {
      position: absolute;
      inset: 1.1rem;
      border: 1px solid #231f20;
      pointer-events: none;
    }
    .marco::after {
      content: "";
      position: absolute;
      inset: 10px;
      border: 1px solid #d9584a;
    }

    .contenido {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      max-width: 420px;
    }

    .etiqueta {
      font-family: "Cormorant", serif;
      font-weight: 500;
      font-size: 1.25rem;
      letter-spacing: 0.45em;
      text-transform: uppercase;
      color: #8a8681;
      margin: 0 0 1.4rem 0.45em;
    }

    /* --- monograma editorial: S grande + resto del nombre tracked --- */
    .monograma {
      position: relative;
      display: flex;
      align-items: baseline;
      justify-content: center;
      line-height: 1;
    }

    .inicial {
      font-family: "Cormorant", serif;
      font-style: italic;
      font-weight: 500;
      font-size: clamp(5rem, 26vw, 7.5rem);
      color: #d9584a;
    }

    .resto {
      font-family: "Cormorant", serif;
      font-style: italic;
      font-weight: 800;
      font-size: clamp(2.4rem, 11vw, 3.4rem);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #d9584a;
      margin-left: 0.1em;
    }

    /* --- mariposa: pegada arriba a la derecha del monograma, sin aire extra --- */
    .mariposa {
      position: absolute;
      top: -2%;
      right: -6%;
      width: clamp(38px, 11vw, 52px);
      height: auto;
      filter: drop-shadow(0 3px 6px rgba(35, 31, 32, 0.15));
    }

    .cuerpo-mariposa {
      transform-origin: 42px 39px;
      animation: reposar 3.6s ease-in-out infinite;
    }

    @keyframes reposar {
      0%, 100% { transform: rotate(0deg); }
      50% { transform: rotate(1.5deg) translateY(-1px); }
    }

    .ala-der, .ala-der-inf {
      transform-origin: 42px 39px;
      animation: aletearDer 3.6s ease-in-out infinite;
    }
    .ala-izq, .ala-izq-inf {
      transform-origin: 42px 39px;
      animation: aletearIzq 3.6s ease-in-out infinite;
    }

    @keyframes aletearDer {
      0%, 40%, 100% { transform: scaleX(1); }
      50% { transform: scaleX(0.82); }
    }
    @keyframes aletearIzq {
      0%, 40%, 100% { transform: scaleX(1); }
      50% { transform: scaleX(0.82); }
    }

    /* --- divisor ornamental: línea, rombo, línea --- */
    .divisor-orn {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin: 1.6rem 0 1.2rem;
    }

    .divisor-orn .linea {
      width: 42px;
      height: 1px;
      background: #c9c4be;
    }

    .divisor-orn .rombo {
      width: 6px;
      height: 6px;
      background: #d9584a;
      transform: rotate(45deg);
    }

    .scroll-cue {
      position: absolute;
      bottom: 2.2rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      font-family: "Cormorant", serif;
      font-size: 0.65rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: #a9a6ad;
      animation: rebotar 2.2s ease-in-out infinite;
      z-index: 2;
    }

    @keyframes rebotar {
      0%, 100% { transform: translate(-50%, 0); }
      50% { transform: translate(-50%, 5px); }
    }

    @media (prefers-reduced-motion: reduce) {
      .cuerpo-mariposa,
      .ala-der,
      .ala-izq,
      .ala-der-inf,
      .ala-izq-inf,
      .scroll-cue {
        animation: none !important;
      }
    }
  </style>
</section>