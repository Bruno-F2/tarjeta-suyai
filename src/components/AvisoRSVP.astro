---
// src/components/AvisoRSVP.astro
interface Props {
  texto?: string;
  telefono?: string; // formato para WhatsApp: 549 + código de área sin 0 + número sin 15
  mensaje?: string;
}

const {
  texto = "Confirmar asistencia antes del 20 de octubre",
  telefono = "5492914075048", // reemplazá por el número real, ver instrucciones
  mensaje = "¡Hola! Quiero confirmar mi asistencia a los XV de Suyi 🦋",
} = Astro.props;

const linkWhatsapp = `https://wa.me/${telefono}?text=${encodeURIComponent(mensaje)}`;
---

<div class="aviso-rsvp">
  <p class="texto-aviso">{texto}</p>

  <a class="boton-whatsapp" href={linkWhatsapp} target="_blank" rel="noopener noreferrer">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M12 2C6.48 2 2 6.48 2 12c0 1.85.5 3.58 1.35 5.07L2 22l5.1-1.33A9.94 9.94 0 0 0 12 22c5.52 0 10-4.48 10-10S17.52 2 12 2Zm0 18c-1.6 0-3.09-.46-4.35-1.24l-.31-.19-3.03.79.8-2.95-.2-.3A7.94 7.94 0 0 1 4 12c0-4.41 3.59-8 8-8s8 3.59 8 8-3.59 8-8 8Zm4.38-5.86c-.24-.12-1.43-.71-1.65-.79-.22-.08-.38-.12-.54.12-.16.24-.62.79-.76.95-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.44-1.34-1.68-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.19-.46-.39-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.11.16 1.53.1.47-.07 1.43-.58 1.63-1.15.2-.57.2-1.05.14-1.15-.06-.1-.22-.16-.46-.28Z"/>
    </svg>
    Confirmar por WhatsApp
  </a>
</div>

<style>
  .aviso-rsvp {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 0 1.5rem 2.5rem;
    background: #fffdfb;
  }

  .texto-aviso {
    margin: 0;
    padding: 0.7rem 1.5rem;
    border: 1px solid #d9584a;
    border-radius: 999px;
    background: rgba(217, 88, 74, 0.06);
    font-family: "Cormorant", serif;
    font-weight: 500;
    font-size: clamp(0.85rem, 3.6vw, 0.95rem);
    letter-spacing: 0.08em;
    color: #d9584a;
    text-align: center;
  }

  .boton-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    background: #25d366;
    color: #fffdfb;
    font-family: "Cormorant", serif;
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-decoration: none;
  }
</style>