---
// src/components/Galeria.astro
interface Foto {
  src?: string;
  alt?: string;
}

interface Props {
  fotos?: Foto[];
}

// Mientras no tengas las fotos reales, dejá src vacío y se muestra un
// placeholder con el mismo estilo del sitio. Cuando las tengas, pasalas así:
// <Galeria fotos={[{ src: '/fotos/1.jpg', alt: 'Suyi en el parque' }, ...]} />
const {
  fotos = [
    { src: "", alt: "Foto de la sesión 1" },
    { src: "", alt: "Foto de la sesión 2" },
    { src: "", alt: "Foto de la sesión 3" },
  ],
} = Astro.props;
---

<section class="galeria">
  <div class="carrusel" id="carrusel">
    {
      fotos.map((foto) => (
        <div class="foto">
          {foto.src ? (
            <img src={foto.src} alt={foto.alt} loading="lazy" />
          ) : (
            <div class="placeholder" aria-hidden="true">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none">
                <rect x="2.5" y="5.5" width="19" height="14" rx="1.5" stroke="currentColor" stroke-width="1.3" />
                <circle cx="8.5" cy="10.5" r="1.6" stroke="currentColor" stroke-width="1.3" />
                <path d="M4 17 L9 12.5 L13 15.5 L16 12 L20.5 16.5" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" fill="none" />
              </svg>
              <span>Foto próximamente</span>
            </div>
          )}
        </div>
      ))
    }
  </div>

  <div class="puntos" id="puntos" aria-hidden="true">
    {fotos.map((_, i) => <span class="punto" data-indice={i}></span>)}
  </div>
</section>

<script>
  function inicializarCarrusel(seccion: HTMLElement) {
    const carrusel = seccion.querySelector<HTMLElement>(".carrusel")!;
    const fotos = Array.from(seccion.querySelectorAll<HTMLElement>(".foto"));
    const puntos = Array.from(seccion.querySelectorAll<HTMLElement>(".punto"));

    if (fotos.length <= 1) return;

    const observer = new IntersectionObserver(
      (entradas) => {
        entradas.forEach((entrada) => {
          if (entrada.isIntersecting) {
            const indice = fotos.indexOf(entrada.target as HTMLElement);
            puntos.forEach((p, i) => p.classList.toggle("activo", i === indice));
          }
        });
      },
      { root: carrusel, threshold: 0.6 }
    );

    fotos.forEach((foto) => observer.observe(foto));
  }

  document.querySelectorAll<HTMLElement>(".galeria").forEach(inicializarCarrusel);
</script>

<style>
  .galeria {
    padding: 3rem 0;
    background: #fffdfb;
  }

  /* --- carrusel: mobile-first, slider horizontal con snap --- */
  .carrusel {
    display: flex;
    gap: 0.9rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 0 12vw 0.5rem; /* deja ver un poco del siguiente/anterior a los costados */
    scrollbar-width: none;
  }
  .carrusel::-webkit-scrollbar {
    display: none;
  }

  .foto {
    flex: 0 0 76vw;
    scroll-snap-align: center;
    aspect-ratio: 4 / 5;
    max-height: 62dvh; /* nunca más alto que la pantalla del dispositivo */
    border-radius: 4px;
    overflow: hidden;
  }

  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    background: #f3efed;
    border: 1px solid #e3dcd8;
    color: #b8b0aa;
    font-family: "Cormorant", serif;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* --- puntos indicadores (solo tienen sentido con el slider mobile) --- */
  .puntos {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }

  .punto {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #d9c9c4;
    transition: background-color 0.25s ease, transform 0.25s ease;
  }

  .punto.activo {
    background: #d9584a;
    transform: scale(1.4);
  }

  /* --- pantallas grandes: 3 fotos una al lado de la otra, sin scroll --- */
  @media (min-width: 820px) {
    .carrusel {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      overflow-x: visible;
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 2rem;
      gap: 1.5rem;
    }

    .foto {
      flex: none;
      max-height: none;
    }

    .puntos {
      display: none;
    }
  }
</style>