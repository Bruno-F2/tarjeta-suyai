---
// src/components/MusicaFondo.astro
// Los navegadores (sobre todo en celular, y más el navegador interno de
// WhatsApp) NO dejan que un sitio reproduzca sonido automáticamente sin
// que el usuario haga algo primero. Por eso este botón: el invitado lo
// toca una vez y ahí arranca la canción.
interface Props {
  src?: string;
}

const { src = "/audio/cancion.mp3" } = Astro.props;
---

<div class="musica-fondo">
  <audio id="audio-fondo" src={src} loop preload="none"></audio>

  <button type="button" class="boton-musica" id="boton-musica" aria-label="Reproducir música">
    <span class="anillo" aria-hidden="true"></span>
    <svg class="icono-nota" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M9 18V5l12-2v13"
        stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
      />
      <circle cx="6" cy="18" r="3" stroke="currentColor" stroke-width="1.6" />
      <circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.6" />
    </svg>
  </button>
</div>

<script>
  function inicializarMusica(contenedor: HTMLElement) {
    const audio = contenedor.querySelector<HTMLAudioElement>("#audio-fondo")!;
    const boton = contenedor.querySelector<HTMLButtonElement>("#boton-musica")!;

    boton.addEventListener("click", () => {
      if (audio.paused) {
        audio.play().catch(() => {
          // Si el navegador igual lo bloquea, no rompemos nada;
          // el botón simplemente queda listo para otro intento.
        });
      } else {
        audio.pause();
      }
    });

    audio.addEventListener("play", () => boton.classList.add("sonando"));
    audio.addEventListener("pause", () => boton.classList.remove("sonando"));
  }

  document.querySelectorAll<HTMLElement>(".musica-fondo").forEach(inicializarMusica);
</script>

<style>
  .musica-fondo {
    position: fixed;
    bottom: 1.4rem;
    right: 1.4rem;
    z-index: 500;
  }

  .boton-musica {
    position: relative;
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #d9584a;
    border-radius: 50%;
    background: #fffdfb;
    color: #d9584a;
    cursor: pointer;
    box-shadow: 0 3px 10px rgba(35, 31, 32, 0.12);
  }

  .icono-nota {
    position: relative;
    z-index: 2;
  }

  .anillo {
    position: absolute;
    inset: -4px;
    border: 1px solid #d9584a;
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.85);
  }

  /* Cuando está sonando: el ícono gira lento y el anillo pulsa */
  .boton-musica.sonando .icono-nota {
    animation: girar 6s linear infinite;
  }

  .boton-musica.sonando .anillo {
    animation: pulso 1.8s ease-out infinite;
  }

  @keyframes girar {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes pulso {
    0% { opacity: 0.5; transform: scale(0.85); }
    100% { opacity: 0; transform: scale(1.5); }
  }

  @media (prefers-reduced-motion: reduce) {
    .boton-musica.sonando .icono-nota,
    .boton-musica.sonando .anillo {
      animation: none;
    }
  }
</style>