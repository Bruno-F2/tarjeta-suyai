---
// src/components/BuenDeseo.astro
// Usa Netlify Forms: no necesita ninguna key ni servicio externo.
// Los mensajes quedan guardados en tu panel de Netlify > Site > Forms.
// IMPORTANTE: esto solo funciona en el sitio ya publicado en Netlify,
// NO funciona corriendo "npm run dev" en tu computadora.
---

<section class="buen-deseo">
  <p class="titulo">¿Me dejas un buen deseo?</p>

  <form
    name="buen-deseo"
    method="POST"
    data-netlify="true"
    id="form-deseo"
    class="form-deseo"
  >
    <input type="hidden" name="form-name" value="buen-deseo" />

    <input
      type="text"
      name="nombre"
      id="nombre-deseo"
      class="input-texto"
      placeholder="Tu nombre"
      autocomplete="off"
      required
    />
    <textarea
      name="mensaje"
      id="mensaje-deseo"
      class="textarea-deseo"
      placeholder="Escribí tu buen deseo..."
      rows="4"
      required
    ></textarea>
    <button type="submit" class="boton-enviar" id="boton-enviar">Enviar deseo</button>
  </form>

  <p class="feedback" id="feedback-deseo" hidden></p>
</section>

<script>
  function inicializarDeseo(seccion: HTMLElement) {
    const form = seccion.querySelector<HTMLFormElement>("#form-deseo")!;
    const boton = seccion.querySelector<HTMLButtonElement>("#boton-enviar")!;
    const feedback = seccion.querySelector<HTMLElement>("#feedback-deseo")!;

    form.addEventListener("submit", async (evento) => {
      evento.preventDefault();

      boton.disabled = true;
      boton.textContent = "Enviando...";

      try {
        const datos = new FormData(form);
        await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(datos as unknown as Record<string, string>).toString(),
        });

        form.hidden = true;
        feedback.hidden = false;
        feedback.textContent = "¡Gracias por tu deseo! 💛";
      } catch {
        feedback.hidden = false;
        feedback.textContent = "No se pudo enviar. ¿Podés intentar de nuevo?";
        feedback.classList.add("error");
        boton.disabled = false;
        boton.textContent = "Enviar deseo";
      }
    });
  }

  document.querySelectorAll<HTMLElement>(".buen-deseo").forEach(inicializarDeseo);
</script>

<style>
  .buen-deseo {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 3.5rem 1.75rem;
    background: #fffdfb;
    text-align: center;
  }

  .titulo {
    margin: 0 0 2rem;
    font-family: "Cormorant Garamond", serif;
    font-style: italic;
    font-size: clamp(1.2rem, 5.5vw, 1.5rem);
    color: #231f20;
  }

  .form-deseo {
    width: 100%;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .input-texto,
  .textarea-deseo {
    box-sizing: border-box;
    width: 100%;
    padding: 0.7rem 1rem;
    border: 1px solid #d9c9c4;
    border-radius: 6px;
    background: #fffdfb;
    font-family: "Cormorant", serif;
    font-size: 1rem;
    color: #231f20;
    resize: vertical;
  }

  .input-texto:focus,
  .textarea-deseo:focus {
    outline: none;
    border-color: #d9584a;
  }

  .boton-enviar {
    align-self: center;
    margin-top: 0.4rem;
    padding: 0.85rem 1.9rem;
    border: 1px solid #231f20;
    border-radius: 999px;
    background: #231f20;
    color: #fffdfb;
    font-family: "Cormorant", serif;
    font-weight: 500;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .boton-enviar:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .feedback {
    margin-top: 0.5rem;
    font-family: "Cormorant Garamond", serif;
    font-style: italic;
    font-size: 1.05rem;
    color: #d9584a;
  }

  .feedback.error {
    color: #a15b4f;
  }
</style>