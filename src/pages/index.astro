---
import Layout from "../layouts/Layout.astro";
import Reveal from "../components/Reveal.astro";
import Portada from "../components/Portada.astro";
import Timer from "../components/Timer.astro";
import Frase from "../components/Frase.astro";
import Ubicacion from "../components/Ubicacion.astro";
import Galeria from "../components/Galeria.astro";
import AvisoRSVP from "../components/AvisoRSVP.astro";
import SobreVirtual from "../components/SobreVirtual.astro";
import Quizcorazon from "../components/Quizcorazon.astro";
import BuenDeseo from "../components/BuenDeseo.astro";
import Teespero from "../components/Teespero.astro";
---

<Layout>
  <Reveal>
    <Portada />
  </Reveal>
  <Reveal>
    <Timer
      fechaEvento="2026-10-31T00:00:00"
      horaEntrada="2026-10-31T21:30:00"
    />
  </Reveal>
  <Reveal>
    <Frase />
  </Reveal>
  <Reveal>
    <Ubicacion />
  </Reveal>
  <Reveal>
    <Galeria
      fotos={[
        { src: "/fotos/foto1.jpg", alt: "Suyi con la pety" },
        { src: "/fotos/foto2.jpg", alt: "Suyi sentada" },
        { src: "/fotos/foto3.jpg", alt: "Suyi con un bengala" },
      ]}
    />
  </Reveal>
  <Reveal>
    <AvisoRSVP />
  </Reveal>
  <SobreVirtual />
  <Quizcorazon />
  <BuenDeseo />
  <Teespero />
</Layout>
